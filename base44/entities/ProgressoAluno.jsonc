{
  "name": "ProgressoAluno",
  "type": "object",
  "properties": {
    "aula_id": {
      "type": "string",
      "description": "ID da aula"
    },
    "aula_numero": {
      "type": "number",
      "description": "N\u00famero da aula"
    },
    "status": {
      "type": "string",
      "enum": [
        "nao_iniciada",
        "em_andamento",
        "concluida"
      ],
      "default": "nao_iniciada"
    },
    "data_inicio": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o aluno come\u00e7ou esta aula"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o aluno completou a aula"
    },
    "tempo_gasto_minutos": {
      "type": "number",
      "default": 0,
      "description": "Tempo total gasto na aula"
    },
    "exercicios_completados": {
      "type": "array",
      "description": "\u00cdndices dos exerc\u00edcios conclu\u00eddos",
      "items": {
        "type": "number"
      },
      "default": []
    },
    "notas_aluno": {
      "type": "string",
      "description": "Anota\u00e7\u00f5es pessoais do aluno sobre a aula"
    },
    "avaliacao": {
      "type": "number",
      "description": "Avalia\u00e7\u00e3o da aula (1-5 estrelas)",
      "minimum": 1,
      "maximum": 5
    },
    "dificuldades": {
      "type": "array",
      "description": "Dificuldades encontradas pelo aluno",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "aula_id",
    "aula_numero"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}