{
  "name": "Setlist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do setlist"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do setlist ou evento"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Data do evento"
    },
    "location": {
      "type": "string",
      "description": "Local do evento"
    },
    "songs": {
      "type": "array",
      "description": "IDs das m\u00fasicas na ordem do setlist",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "description": "Notas ou observa\u00e7\u00f5es sobre o setlist"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}