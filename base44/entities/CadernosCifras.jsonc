{
  "name": "CadernosCifras",
  "type": "object",
  "properties": {
    "nome_caderno": {
      "type": "string",
      "description": "Nome do caderno ou cole\u00e7\u00e3o"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL do PDF principal"
    },
    "pdf_urls_adicionais": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de PDFs adicionais do mesmo caderno"
    },
    "lista_pdfs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "URL do arquivo PDF"
          },
          "nome": {
            "type": "string",
            "description": "Nome do arquivo"
          },
          "ordem": {
            "type": "number",
            "description": "Ordem no caderno"
          }
        }
      },
      "description": "Lista completa de PDFs com metadados"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do conte\u00fado do caderno"
    },
    "cifras_extraidas": {
      "type": "array",
      "description": "Cifras extra\u00eddas do PDF",
      "items": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "description": "T\u00edtulo da m\u00fasica"
          },
          "artista": {
            "type": "string",
            "description": "Nome do artista"
          },
          "cifra_completa": {
            "type": "string",
            "description": "Texto completo da cifra"
          },
          "tom": {
            "type": "string",
            "description": "Tonalidade"
          },
          "pagina": {
            "type": "number",
            "description": "P\u00e1gina no PDF onde est\u00e1 a cifra"
          }
        }
      }
    },
    "total_musicas": {
      "type": "number",
      "description": "Total de m\u00fasicas encontradas",
      "default": 0
    },
    "processado": {
      "type": "boolean",
      "description": "Se o PDF j\u00e1 foi processado e as cifras extra\u00eddas",
      "default": false
    },
    "data_upload": {
      "type": "string",
      "format": "date-time",
      "description": "Data do upload"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para organiza\u00e7\u00e3o (sertanejo, gospel, MPB, etc)"
    },
    "lotes_processados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lote_id": {
            "type": "number",
            "description": "ID do lote"
          },
          "range": {
            "type": "string",
            "description": "Intervalo de p\u00e1ginas (ex: 1-20)"
          },
          "data_processamento": {
            "type": "string",
            "format": "date-time",
            "description": "Quando foi processado"
          }
        }
      },
      "description": "Hist\u00f3rico de lotes j\u00e1 processados",
      "default": []
    },
    "config_lotes": {
      "type": "object",
      "description": "Configura\u00e7\u00e3o de lotes para processamento gradual",
      "properties": {
        "ativado": {
          "type": "boolean",
          "description": "Se o modo lote est\u00e1 ativado",
          "default": false
        },
        "total_paginas": {
          "type": "number",
          "description": "Total de p\u00e1ginas do PDF"
        },
        "lotes_gerados": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "range": {
                "type": "string"
              }
            }
          },
          "description": "Lotes gerados para processamento"
        }
      }
    }
  },
  "required": [
    "nome_caderno",
    "pdf_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}