{
  "name": "Exercise",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo do exerc\u00edcio"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do exerc\u00edcio"
    },
    "song_id": {
      "type": "string",
      "description": "ID da m\u00fasica relacionada"
    },
    "song_title": {
      "type": "string",
      "description": "T\u00edtulo da m\u00fasica relacionada"
    },
    "category": {
      "type": "string",
      "enum": [
        "palhetada",
        "dedilhado",
        "acordes",
        "ritmo",
        "velocidade",
        "transicao",
        "tecnica_geral"
      ],
      "description": "Categoria do exerc\u00edcio"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "iniciante",
        "intermediario",
        "avancado",
        "expert"
      ],
      "default": "intermediario",
      "description": "N\u00edvel de dificuldade"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o recomendada em minutos"
    },
    "instructions": {
      "type": "string",
      "description": "Instru\u00e7\u00f5es passo a passo"
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dicas importantes"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Objetivos do exerc\u00edcio"
    },
    "progression": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "N\u00edveis de progress\u00e3o"
    },
    "completed_count": {
      "type": "number",
      "default": 0,
      "description": "Quantas vezes foi completado"
    },
    "last_practiced": {
      "type": "string",
      "format": "date",
      "description": "\u00daltima vez que foi praticado"
    },
    "user_notes": {
      "type": "string",
      "description": "Notas do usu\u00e1rio sobre o exerc\u00edcio"
    },
    "rating": {
      "type": "number",
      "description": "Avalia\u00e7\u00e3o do usu\u00e1rio (1-5)"
    }
  },
  "required": [
    "title",
    "description",
    "category",
    "difficulty"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}