{
  "name": "Partitura",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da pe\u00e7a instrumental"
    },
    "composer": {
      "type": "string",
      "description": "Compositor da pe\u00e7a"
    },
    "instrument": {
      "type": "string",
      "description": "Instrumento principal (ex: Viol\u00e3o, Violino, Piano, Viola)"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL do arquivo PDF da partitura"
    },
    "audio_url": {
      "type": "string",
      "description": "URL do \u00e1udio de refer\u00eancia (opcional)"
    },
    "playback_url": {
      "type": "string",
      "description": "URL do playback/base para tocar junto"
    },
    "key": {
      "type": "string",
      "description": "Tonalidade da pe\u00e7a"
    },
    "difficulty_level": {
      "type": "string",
      "enum": [
        "facil",
        "intermediario",
        "avancado"
      ],
      "default": "intermediario",
      "description": "N\u00edvel de dificuldade"
    },
    "genre": {
      "type": "string",
      "description": "G\u00eanero instrumental (ex: Cl\u00e1ssico, Choro, Jazz, Sertanejo Instrumental)"
    },
    "description": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre a pe\u00e7a"
    }
  },
  "required": [
    "title",
    "pdf_url"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}